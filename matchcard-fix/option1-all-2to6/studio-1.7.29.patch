+        // The title names the installed helper so an update is visible at a glance;
+        // the original "1.0.2" release number is replaced rather than duplicated.
+        private static void ShowHelperVersion(Window window)
+        {
+            // Cosmetic only: a failure here must never stop Studio from starting.
+            try
+            {
+                string version = typeof(FolderBridge).Assembly.GetName().Version.ToString(3);
+                string title = window.Title ?? "";
+                if (!title.Contains(version))
+                    window.Title = title.Contains("1.0.2") ? title.Replace("1.0.2", version) : (title.Length == 0 ? "Gorilla Studio" : title) + " v" + version;
+                // The window draws its own header badge ("MOVING RENDERS · v1.0.2"); its
+                // templated parts exist only once the UI is idle after loading.
+                window.Dispatcher.BeginInvoke(DispatcherPriority.ContextIdle, new Action(() =>
+                {
+                    try { ReplaceVersionText(window, "v1.0.2", "v" + version, 0); }
+                    catch (Exception) { }
+                }));
+            }
+            catch (Exception) { }
+        }
+
+        private static void ReplaceVersionText(DependencyObject node, string from, string to, int depth)
+        {
+            if (node == null || depth > 64) return;
+            var block = node as TextBlock;
+            // Setting Text rebuilds the inline runs, so nothing iterates them while editing.
+            if (block != null && block.Text != null && block.Text.Contains(from)) block.Text = block.Text.Replace(from, to);
+            var children = new List<DependencyObject>();
+            if (node is Visual || node is System.Windows.Media.Media3D.Visual3D)
+                for (int i = 0, count = VisualTreeHelper.GetChildrenCount(node); i < count; i++) children.Add(VisualTreeHelper.GetChild(node, i));
+            foreach (DependencyObject child in children) ReplaceVersionText(child, from, to, depth + 1);
+        }
+
