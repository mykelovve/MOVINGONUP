+def _register_hair_coverage_repair():
+    """Cut strands out of hair-card meshes the renderer left fully opaque.
+
+    The original renderer gives its strand cut-out only to the meshes named in
+    its hair option. Body hair (combinations), beards and the like that are not
+    named there render every card as a solid patch, which shows as pale blotches
+    over shirts and tights. Their own RAI texture carries strand coverage in its
+    green channel, exactly as the renderer's hair material reads it.
+    """
+    import bpy
+
+    handlers = getattr(getattr(bpy, "app", None), "handlers", None)
+    if handlers is None:
+        return
+    for previous in list(handlers.render_pre):
+        if getattr(previous, "_gorilla_hair_coverage_repair", False):
+            handlers.render_pre.remove(previous)
+    words = ("hair", "combination", "beard", "mustache", "goatee", "brow")
+    cut = 0.06
+    done = set()      # materials already cut out, or that this pass leaves alone
+    copies = {}       # original material pointer -> its cut-out private copy
+
+    def stem_of(obj):
+        stem = obj.name.split(":", 1)[0]
+        if "." in stem and stem.rsplit(".", 1)[1].isdigit():
+            stem = stem.rsplit(".", 1)[0]
+        return stem
+
+    def principled(material):
+        if not material.use_nodes or material.node_tree is None:
+            return None
+        for output in material.node_tree.nodes:
+            if output.type != "OUTPUT_MATERIAL" or not getattr(output, "is_active_output", True):
+                continue
+            links = output.inputs["Surface"].links
+            if len(links) == 1 and links[0].from_node.type == "BSDF_PRINCIPLED":
+                return links[0].from_node
+        return None
+
+    def coverage_image(tree, shader):
+        textures = [node for node in tree.nodes if node.type == "TEX_IMAGE" and node.image is not None]
+        named = [node for node in textures if "_rai" in node.image.name.lower()]
+        if named:
+            return named[0]
+        links = shader.inputs["Base Color"].links
+        if len(links) == 1 and links[0].from_node.type == "TEX_IMAGE" and links[0].from_node.image is not None:
+            return links[0].from_node
+        return None
+
+    def repair(scene, unused_depsgraph=None):
+        for obj in scene.objects:
+            if obj.type != "MESH" or getattr(obj, "hide_render", False):
+                continue
+            stem = stem_of(obj)
+            lower = stem.lower()
+            if not lower.endswith("_alpha") or not any(word in lower for word in words):
+                continue
+            for slot in obj.material_slots:
+                material = slot.material
+                if material is None or material.as_pointer() in done:
+                    continue
+                if material.as_pointer() in copies:
+                    try:
+                        slot.link = "OBJECT"
+                        slot.material = copies[material.as_pointer()]
+                    except (RuntimeError, ReferenceError):
+                        pass
+                    continue
+                try:
+                    shader = principled(material)
+                    if shader is None or shader.inputs["Alpha"].links:
+                        done.add(material.as_pointer())
+                        continue  # Already cut out (or not a shader this pass knows).
+                    if coverage_image(material.node_tree, shader) is None:
+                        done.add(material.as_pointer())
+                        continue
+                    # A private copy: the same material may also dress a body.
+                    copy = material.copy()
+                    tree = copy.node_tree
+                    target = principled(copy)
+                    source = coverage_image(tree, target)
+                    separate = tree.nodes.new("ShaderNodeSeparateColor")
+                    separate.label = "Gorilla hair coverage"
+                    tree.links.new(source.outputs["Color"], separate.inputs[0])
+                    lower_cut = tree.nodes.new("ShaderNodeMath")
+                    lower_cut.operation = "SUBTRACT"
+                    lower_cut.inputs[1].default_value = cut
+                    tree.links.new(separate.outputs[1], lower_cut.inputs[0])
+                    scale = tree.nodes.new("ShaderNodeMath")
+                    scale.operation = "MULTIPLY"
+                    scale.use_clamp = True
+                    scale.inputs[1].default_value = 1.0 / (1.0 - cut)
+                    tree.links.new(lower_cut.outputs[0], scale.inputs[0])
+                    tree.links.new(scale.outputs[0], target.inputs["Alpha"])
+                    for name, value in (("surface_render_method", "DITHERED"), ("blend_method", "HASHED"),
+                                        ("shadow_method", "HASHED")):
+                        try:
+                            setattr(copy, name, value)
+                        except (AttributeError, TypeError, ValueError):
+                            pass
+                    slot.link = "OBJECT"
+                    slot.material = copy
+                    done.add(copy.as_pointer())
+                    copies[material.as_pointer()] = copy
+                    print("  hair coverage added to", stem, "from", source.image.name, flush=True)
+                except Exception as error:  # A cosmetic pass must never stop a render.
+                    done.add(material.as_pointer())
+                    print("  hair coverage skipped:", stem, str(error), flush=True)
+
+    repair._gorilla_hair_coverage_repair = True
+    repair = handlers.persistent(repair)
+    handlers.render_pre.append(repair)
+
+
+try:
+    _register_hair_coverage_repair()
+except ImportError:
+    pass  # Non-rendering tools may import this module without Blender.
+
