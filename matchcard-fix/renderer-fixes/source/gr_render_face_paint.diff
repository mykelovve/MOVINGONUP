+_FACE_PAINT_WORDS = ("paint", "makeup", "make_up", "decal", "facepaint", "warpaint")
+_FACE_PAINT_SKIP = ("_nrm", "_normal", "_rai", "_spec", "_flush", "_mask", "_ao", "_rough", "wrinkle", "_cavity", "_height")
