+def _face_paint_folders(options):
+    """BaseModel and selected-attire texture/material folders of the rendered character."""
+    char = options.get("char_dir")
+    if not char or not os.path.isdir(char):
+        return None
+    attire = options.get("attire_mcd", "")
+    attire_dir = os.path.dirname(attire if os.path.isabs(attire) else os.path.join(char, attire)) if attire else None
+    folders = {"base": os.path.join(char, "BaseModel")}
+    if attire_dir and os.path.isdir(attire_dir):
+        folders["attire"] = attire_dir
+    return folders
+
+
+def _jmtl_refs(path):
+    """Every 8-byte reference stored in a head material, as 16-digit hex in both byte orders."""
+    try:
+        with open(path, "rb") as stream:
+            data = stream.read(1 << 20)
+    except OSError:
+        return set()
+    refs = set()
+    for offset in range(0, len(data) - 7, 4):
+        chunk = data[offset:offset + 8]
+        if chunk.count(0) > 2 or chunk == b"\xff" * 8:
+            continue
+        refs.add(chunk.hex())
+        refs.add(chunk[::-1].hex())
+    return refs
+
+
+def _face_paint_candidates(folders):
+    """Paint layers (and painted head colours) shipped beside the head, attire first.
+
+    Returns (attire_head_colour or None, [paint texture paths], [notes]).
+    A face-paint layer is a texture next to the head textures named for paint
+    or make-up, or a hash-named texture that the head material references.
+    """
+    notes, paints, attire_head = [], [], None
+    base_head = os.path.join(folders["base"], "Textures", "head_color.dds")
+    for key in ("attire", "base"):
+        folder = folders.get(key)
+        if not folder:
+            continue
+        textures = os.path.join(folder, "Textures")
+        if not os.path.isdir(textures):
+            continue
+        refs = set()
+        for material in ("head.jmtl", "Head.jmtl", "m_head.jmtl"):
+            path = os.path.join(folder, "Materials", material)
+            if os.path.isfile(path):
+                refs |= _jmtl_refs(path)
+        for name in sorted(os.listdir(textures), key=str.lower):
+            path = os.path.join(textures, name)
+            stem, extension = os.path.splitext(name.lower())
+            if extension not in (".dds", ".png", ".tga") or not os.path.isfile(path):
+                continue
+            if stem == "head_color":
+                if key == "attire":
+                    try:
+                        differs = not os.path.isfile(base_head) or os.path.getsize(path) != os.path.getsize(base_head) \
+                            or open(path, "rb").read() != open(base_head, "rb").read()
+                    except OSError:
+                        differs = False
+                    if differs:
+                        attire_head = path
+                        notes.append("attire head colour: " + path)
+                continue
+            if any(word in stem for word in _FACE_PAINT_SKIP):
+                continue
+            named = any(word in stem for word in _FACE_PAINT_WORDS)
+            hashed = len(stem) == 16 and all(c in "0123456789abcdef" for c in stem) and stem in refs
+            if named or hashed:
+                paints.append(path)
+                notes.append(key + " paint candidate: " + path + (" (referenced by head material)" if hashed else ""))
+    return attire_head, paints, notes
+
