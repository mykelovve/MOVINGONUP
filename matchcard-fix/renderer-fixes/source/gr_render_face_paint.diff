+def _register_face_paint():
+    """Keep face paint on the head through every rendered frame.
+
+    The original renderer gives the head only its head_color texture, so a
+    paint layer shipped beside it (or a painted head colour in the attire
+    folder) never reaches the render. This lays the paint over the head
+    colour by its own alpha, in the head material, before each frame.
+    """
+    import bpy
+
+    handlers = getattr(getattr(bpy, "app", None), "handlers", None)
+    if handlers is None:
+        return
+    for previous in list(handlers.render_pre):
+        if getattr(previous, "_gorilla_face_paint", False):
+            handlers.render_pre.remove(previous)
+    folders = _face_paint_folders(_renderer_options())
+    report_path = os.path.join(os.path.dirname(os.path.abspath(__file__)), "face_paint_report.txt")
+    if folders is None:
+        return
+    attire_head, paints, notes = _face_paint_candidates(folders)
+    done = set()
+    state = {"reported": False, "images": {}}
+
+    def report(lines):
+        if state["reported"]:
+            return
+        state["reported"] = True
+        text = ["character: " + os.path.dirname(folders["base"])] + notes + lines
+        for line in lines:
+            print("  face paint:", line, flush=True)
+        try:
+            with open(report_path, "w", encoding="utf-8") as stream:
+                stream.write("\n".join(text) + "\n")
+        except OSError:
+            pass
+
+    def load(path):
+        if path not in state["images"]:
+            try:
+                state["images"][path] = bpy.data.images.load(path, check_existing=True)
+            except (RuntimeError, OSError):
+                state["images"][path] = None
+        return state["images"][path]
+
+    def alpha_kind(image):
+        """'overlay' when the alpha cuts out a layer, 'opaque' when it covers everything, else None."""
+        try:
+            copy = image.copy()
+            try:
+                copy.scale(128, 128)
+                values = list(copy.pixels[3::4])
+            finally:
+                bpy.data.images.remove(copy)
+        except (RuntimeError, ValueError, ReferenceError):
+            return None
+        if not values:
+            return None
+        clear = sum(1 for value in values if value < 0.1)
+        solid = sum(1 for value in values if value > 0.5)
+        if solid == 0:
+            return None
+        if clear >= len(values) * 0.05:
+            return "overlay"
+        return "opaque" if clear == 0 else "overlay"
+
+    def head_colour_node(material):
+        if not material.use_nodes or material.node_tree is None:
+            return None
+        nodes = [node for node in material.node_tree.nodes if node.type == "TEX_IMAGE" and node.image is not None]
+        named = [node for node in nodes if "head_color" in (node.image.name + " " + node.image.filepath).lower().replace("\\", "/")]
+        if named:
+            return named[0]
+        for shader in material.node_tree.nodes:
+            if shader.type != "BSDF_PRINCIPLED":
+                continue
+            pending = [link.from_node for link in shader.inputs["Base Color"].links]
+            seen = set()
+            while pending:
+                node = pending.pop()
+                if node.as_pointer() in seen:
+                    continue
+                seen.add(node.as_pointer())
+                if node.type == "TEX_IMAGE" and node.image is not None:
+                    return node
+                for socket in node.inputs:
+                    pending.extend(link.from_node for link in socket.links)
+        return None
+
+    def mix_node(tree):
+        try:
+            mix = tree.nodes.new("ShaderNodeMix")
+            mix.data_type = "RGBA"
+            mix.blend_type = "MIX"
+            factor = next(socket for socket in mix.inputs if socket.name == "Factor" and socket.type == "VALUE")
+            first = next(socket for socket in mix.inputs if socket.name == "A" and socket.type == "RGBA")
+            second = next(socket for socket in mix.inputs if socket.name == "B" and socket.type == "RGBA")
+            result = next(socket for socket in mix.outputs if socket.name == "Result" and socket.type == "RGBA")
+            return mix, factor, first, second, result
+        except (RuntimeError, StopIteration, AttributeError, TypeError):
+            mix = tree.nodes.new("ShaderNodeMixRGB")
+            return mix, mix.inputs["Fac"], mix.inputs["Color1"], mix.inputs["Color2"], mix.outputs["Color"]
+
+    def apply(material, head):
+        lines = []
+        tree = material.node_tree
+        if attire_head:
+            image = load(attire_head)
+            if image is not None:
+                image.colorspace_settings.name = head.image.colorspace_settings.name
+                head.image = image
+                lines.append("head uses the attire's own head colour")
+        for path in paints:
+            image = load(path)
+            if image is None:
+                lines.append("could not load " + path)
+                continue
+            kind = alpha_kind(image)
+            if kind == "opaque" and any(word in os.path.basename(path).lower() for word in _FACE_PAINT_WORDS):
+                image.colorspace_settings.name = head.image.colorspace_settings.name
+                head.image = image
+                lines.append("painted head colour applied: " + path)
+                return lines
+            if kind != "overlay":
+                lines.append("skipped (no paint alpha): " + path)
+                continue
+            image.colorspace_settings.name = head.image.colorspace_settings.name
+            try:
+                image.alpha_mode = "STRAIGHT"
+            except (AttributeError, TypeError):
+                pass
+            paint = tree.nodes.new("ShaderNodeTexImage")
+            paint.image = image
+            paint.interpolation = head.interpolation
+            paint.location = (head.location[0], head.location[1] - 300)
+            vector = head.inputs["Vector"].links
+            if vector:
+                tree.links.new(vector[0].from_socket, paint.inputs["Vector"])
+            targets = [link.to_socket for link in head.outputs["Color"].links]
+            mix, factor, first, second, result = mix_node(tree)
+            mix.location = (head.location[0] + 250, head.location[1] - 150)
+            tree.links.new(head.outputs["Color"], first)
+            tree.links.new(paint.outputs["Color"], second)
+            tree.links.new(paint.outputs["Alpha"], factor)
+            for target in targets:
+                tree.links.new(result, target)
+            lines.append("paint layer applied over the head: " + path)
+            return lines
+        return lines
+
+    def repair(scene, unused_depsgraph=None):
+        lines = []
+        for obj in scene.objects:
+            if obj.type != "MESH":
+                continue
+            for slot in obj.material_slots:
+                material = slot.material
+                if material is None or material.as_pointer() in done:
+                    continue
+                if material.name.split(":", 1)[0].strip("_").lower() not in ("head", "m_head"):
+                    continue
+                done.add(material.as_pointer())
+                if material.get("gorilla_face_paint"):
+                    continue
+                head = head_colour_node(material)
+                if head is None:
+                    lines.append("head material " + material.name + " has no colour texture")
+                    continue
+                try:
+                    applied = apply(material, head)
+                    lines.extend(applied)
+                    if any(line.startswith(("paint layer", "painted head", "head uses")) for line in applied):
+                        material["gorilla_face_paint"] = 1
+                except (RuntimeError, KeyError, AttributeError, TypeError, ReferenceError) as error:
+                    lines.append("could not apply paint: " + str(error))
+        if lines or not state["reported"]:
+            if not paints and not attire_head:
+                lines.append("no face paint layer next to this character's head textures")
+            report(lines)
+
+    repair._gorilla_face_paint = True
+    repair = handlers.persistent(repair)
+    handlers.render_pre.append(repair)
+
