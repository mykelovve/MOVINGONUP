+            int clips = selected.Sum(SlotCount);
+            if (clips > MaxCardClips)
+                throw new InvalidDataException(SelectionFile + " needs " + clips + " portrait movies per card; the Moving Renders plugin plays at most " + MaxCardClips
+                    + " beside a card's background movies. Remove some match types; no layout files were changed.");
+            return selected.AsReadOnly();
+        }
