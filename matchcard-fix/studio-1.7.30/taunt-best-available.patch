+        // Mods override the base game; among base archives the highest bakedfile
+        // number is the newest patch; among mods the most recently written file wins.
+        private static Tuple<int, long, string> SourceRank(Accepted value)
+        {
+            string path = value.Index.ArchivePath ?? "";
+            string normalized = path.Replace('\\', '/');
+            bool mod = normalized.IndexOf("/mods/", StringComparison.OrdinalIgnoreCase) >= 0;
+            long order = 0;
+            if (mod)
+            {
+                try { order = File.GetLastWriteTimeUtc(path).Ticks; }
+                catch (Exception) { order = 0; } // Ordering only; an unreadable date ranks oldest.
+            }
+            else
+            {
+                Match baked = Regex.Match(Path.GetFileName(path), @"bakedfile0*([0-9]+)", RegexOptions.IgnoreCase | RegexOptions.CultureInvariant);
+                if (baked.Success) long.TryParse(baked.Groups[1].Value, out order);
+            }
+            return Tuple.Create(mod ? 1 : 0, order, path.ToLowerInvariant());
+        }
+
