diff --git a/src/GorillaStudio.NameFolders/DiscoveryTauntContextCache.cs b/src/GorillaStudio.NameFolders/DiscoveryTauntContextCache.cs
index 8a61ce3..5eafb32 100644
--- a/src/GorillaStudio.NameFolders/DiscoveryTauntContextCache.cs
+++ b/src/GorillaStudio.NameFolders/DiscoveryTauntContextCache.cs
@@ -73,8 +73,21 @@ namespace GorillaStudio.NameFolders
         private void Changed(object sender, FileSystemEventArgs args)
         {
             // Creation, removal and renaming may change a directory tree, even
-            // when its name has a file extension. Never ignore those events.
-            if (args.ChangeType != WatcherChangeTypes.Changed || Relevant(args.FullPath)) Invalidate();
+            // when its name has a file extension. Only plain files known not to
+            // be sources are ignored: the game, CakeHook and plugins keep writing
+            // logs and status files under the game folder while it runs.
+            var renamed = args as RenamedEventArgs;
+            if (Relevant(args.FullPath) || (renamed != null && Relevant(renamed.OldFullPath))) { Invalidate(); return; }
+            if (args.ChangeType == WatcherChangeTypes.Changed || Noise(args.FullPath)) return;
+            // A created or renamed entry that is now a plain file is not a source.
+            if (args.ChangeType != WatcherChangeTypes.Deleted && File.Exists(args.FullPath)) return;
+            Invalidate();
+        }
+
+        private static bool Noise(string path)
+        {
+            return new[] { ".txt", ".log", ".tmp", ".bak", ".old", ".ini", ".cfg", ".dmp", ".etl", ".png", ".jpg", ".bmp", ".dds" }
+                .Contains(Path.GetExtension(path), StringComparer.OrdinalIgnoreCase);
         }
 
         private static bool Relevant(string path)
