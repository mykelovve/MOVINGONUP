+    private static byte[] WithExtraList(byte[] plain, int entries)
+    {
+        uint tracks = BitConverter.ToUInt32(plain, 0x20);
+        int at = 0xA0 + (int)tracks * 8;
+        var result = new byte[plain.Length + entries * 8];
+        Array.Copy(plain, result, at);
+        for (int index = 0; index < entries * 8; index++) result[at + index] = (byte)(0x5A ^ index);
+        Array.Copy(plain, at, result, at + entries * 8, plain.Length - at);
+        SetU32(result, 0x60, (uint)entries); SetU32(result, 0x64, (uint)entries);
+        return result;
+    }
