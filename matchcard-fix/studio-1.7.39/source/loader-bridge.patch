+        /// <summary>Shows a saved library whose sources are unchanged, exactly as a completed refresh would.</summary>
+        internal static bool IsActiveLibrary(DiscoveryTauntImport import)
+        {
+            return import != null && string.Equals(FolderBridge.DiscoveryEngineRoot, import.Root, StringComparison.OrdinalIgnoreCase);
+        }
+
+        internal static void ApplySaved(Window window, string game, string discoveryRoot, DiscoveryTauntImport import)
+        {
+            RefreshOnDispatcher(window, () => {
+                bool active = IsActiveLibrary(import);
+                if (!active)
+                {
+                    window.GetType().GetField("PrepWanted", Members)?.SetValue(window, null);
+                    window.GetType().GetField("PrepDone", Members)?.SetValue(window, null);
+                }
+                RecordAnimationReport(window, game, discoveryRoot, import);
+                if (active) return;
+                Apply(window, import);
+                window.GetType().GetMethod("Prepare", Members, null, new[] { typeof(string) }, null)?.Invoke(window, new object[] { null });
+            });
+        }
